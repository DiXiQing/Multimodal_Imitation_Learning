"""
test_finger_width_live.py

只测"手指Width检测"这一件事,不涉及方块/IMU/存储,实时开窗口看效果。
方便你现在调摄像头角度/距离的时候,直接盯着画面看MediaPipe到底能不能
稳定检测到手,而不用等录完再看统计数字。

用法:
    python test_finger_width_live.py
    按 'q' 退出,退出时打印这次测试的检测率统计。

画面上会显示:
    - 骨架关键点 (整只手,不只是拇指食指,方便你看是不是有部分手指被裁掉了)
    - 拇指尖(蓝) - 食指尖(红) 连线 + Finger Width (px)
    - 实时检测状态 (绿字 DETECTED / 红字 NO HAND)
    - 实时FPS,方便确认帧率有没有掉太多
"""

import time

import cv2
import numpy as np
import mediapipe as mp

# ─────── 配置 ───────
CAMERA_INDEX = 0
CAP_BACKEND  = cv2.CAP_DSHOW
FRAME_W, FRAME_H = 640, 480

# MediaPipe检测置信度,如果发现实际能检测但阈值太严格导致漏检,可以调低试试
MIN_DETECTION_CONF = 0.3
MIN_TRACKING_CONF  = 0.3
# ────────────────────

THUMB_TIP = 4
INDEX_TIP = 8

mp_hands = mp.solutions.hands
mp_draw  = mp.solutions.drawing_utils


def main():
    cap = cv2.VideoCapture(CAMERA_INDEX, CAP_BACKEND)
    if not cap.isOpened():
        print("[Error] 打不开摄像头")
        return
    cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_W)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_H)

    hands = mp_hands.Hands(
        static_image_mode=False,
        max_num_hands=1,
        min_detection_confidence=MIN_DETECTION_CONF,
        min_tracking_confidence=MIN_TRACKING_CONF,
    )

    print("[System] 按 'q' 退出\n")

    total_frames = 0
    detected_frames = 0
    prev_t = time.time()
    fps = 0.0

    while True:
        ret, frame = cap.read()
        if not ret:
            print("[Error] 读取摄像头帧失败")
            break

        total_frames += 1
        vis = frame.copy()
        h, w = frame.shape[:2]

        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        result = hands.process(rgb)

        detected = bool(result.multi_hand_landmarks)
        finger_width = 0.0

        if detected:
            detected_frames += 1
            lm = result.multi_hand_landmarks[0]

            mp_draw.draw_landmarks(vis, lm, mp_hands.HAND_CONNECTIONS)

            thumb = lm.landmark[THUMB_TIP]
            index = lm.landmark[INDEX_TIP]
            tp = np.array([thumb.x * w, thumb.y * h])
            ip = np.array([index.x * w, index.y * h])
            finger_width = float(np.linalg.norm(tp - ip))

            cv2.circle(vis, tuple(tp.astype(int)), 10, (255, 0, 0), -1)   # 拇指=蓝
            cv2.circle(vis, tuple(ip.astype(int)), 10, (0, 0, 255), -1)   # 食指=红
            cv2.line(vis, tuple(tp.astype(int)), tuple(ip.astype(int)), (0, 255, 255), 2)

        # ── FPS ──
        now = time.time()
        dt = now - prev_t
        prev_t = now
        if dt > 0:
            fps = 0.9 * fps + 0.1 * (1.0 / dt)

        # ── 叠加信息 ──
        status_text = "DETECTED" if detected else "NO HAND"
        status_color = (0, 220, 0) if detected else (0, 0, 255)
        cv2.putText(vis, status_text, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.9, status_color, 2)

        if detected:
            cv2.putText(vis, f"Finger Width: {finger_width:.1f} px", (10, 65),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 200, 255), 2)

        rate = detected_frames / total_frames * 100 if total_frames else 0.0
        cv2.putText(vis, f"Detection rate: {rate:.1f}%  ({detected_frames}/{total_frames})",
                    (10, h - 40), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)
        cv2.putText(vis, f"FPS: {fps:.1f}", (10, h - 15),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 1)

        cv2.imshow("Finger Width Live Test", vis)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

    cap.release()
    cv2.destroyAllWindows()
    hands.close()

    rate = detected_frames / total_frames * 100 if total_frames else 0.0
    print("=" * 50)
    print(f"总帧数         : {total_frames}")
    print(f"检测到手的帧数 : {detected_frames}")
    print(f"检测率         : {rate:.1f}%")
    print("=" * 50)


if __name__ == "__main__":
    main()